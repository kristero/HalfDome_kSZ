#!/bin/bash
#PBS -N ksz_websky
#PBS -q mini_B
#PBS -l select=1:ncpus=16:mem=48gb
#PBS -l walltime=12:00:00
#PBS -j oe
# Halo kSZ maps for the like-for-like WebSky comparison (paint_ksz_websky.jl) and their spectra, on idark (2026-10-02).
# STAGE=paint: self-tests + one catalogue pass, 5 NSIDE-4096 maps; STAGE=spectra: healpy anafast of the maps.
set -euo pipefail
: "${STAGE:?Set STAGE=paint|spectra}"
ROOT=${ROOT:-/lustre/work/kristero10/frb_data/lee22_ksz_websky_20261002}
OUT=$ROOT/frb_map_generation/outputs/lee22_ksz_websky_20261002
CAT=/lustre/work/Globus-lt/halfdome/full_res/halos/lightcone_100.hdf5
NCPU=${PBS_NCPUS:-16}
export JULIA_NUM_THREADS=$NCPU OMP_NUM_THREADS=$NCPU HDF5_USE_FILE_LOCKING=FALSE PYTHONNOUSERSITE=1
export HALO_BLOCK_SIZE=${HALO_BLOCK_SIZE:-256}     # greedy block size of the painter (performance knob only)
# JULIA_RT=1.6 (default, validated): /usr/local/bin/julia; 1.12: the accelerated tSZ runtime (Julia 1.12.2, same XGPaint 35f79ad)
# with a kSZ project (/lustre/work/kristero10/frb_data/ksz_julia112_env; not yet tested on idark)
JULIA_RT=${JULIA_RT:-1.6}
if [ "$JULIA_RT" = 1.12 ]; then
    RT=/lustre/work/kristero10/flamingo_tsz_comparison_20260914/runtime; KE=/lustre/work/kristero10/frb_data/ksz_julia112_env
    export JULIA_PROJECT=$KE/env JULIA_DEPOT_PATH=$KE/depot:$RT/depot:/home/kristero10/.julia
    export LD_LIBRARY_PATH=$RT/julia-1.12.2/lib/julia:${LD_LIBRARY_PATH:-}
    JULIA=$RT/julia-1.12.2/bin/julia
else
    JULIA=/usr/local/bin/julia
fi
cd "$ROOT"; mkdir -p "$OUT/logs"
exec > >(tee -a "$OUT/logs/${STAGE}_${PBS_JOBID:-manual}.log") 2>&1
trap 'echo "finished $(date -Is) stage=$STAGE exit=$?"' EXIT
echo "started $(date -Is) host=$(hostname) stage=$STAGE ncpus=$NCPU julia_rt=$JULIA_RT block=$HALO_BLOCK_SIZE"
sha256sum frb_map_generation/lee2022_frb_dm_profile.jl frb_map_generation/lee22_tsz_corrected/ksz/* truncation_comparison/*.jl > "$OUT/logs/${STAGE}_source_sha256.txt"
case "$STAGE" in
paint)   "$JULIA" --threads="$NCPU" frb_map_generation/lee22_tsz_corrected/ksz/paint_ksz_websky.jl --catalog="$CAT" ;;
spectra) /home/kristero10/.conda/envs/SZ/bin/python frb_map_generation/lee22_tsz_corrected/ksz/ksz_websky_spectra.py --out "$OUT" ;;
*) echo "unknown STAGE $STAGE"; exit 2 ;;
esac
