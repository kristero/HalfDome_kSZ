#!/bin/bash
#PBS -N FLAM_prior_checks
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=64gb
#PBS -l walltime=23:59:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
: "${PILOT:?Set PILOT}"
: "${CAMPAIGN:?Set CAMPAIGN}"
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=26
export PYTHONUNBUFFERED=1 MPLBACKEND=Agg HDF5_USE_FILE_LOCKING=FALSE
review_label=diagnostics
if [[ "${PILOT_REPLOT_ONLY:-0}" == 1 ]]; then review_label=plot_review; fi
exec > "${PILOT}/logs/${review_label}.log" 2>&1
trap 'status=$?; printf "%s\n" "$status" > "${PILOT}/logs/${review_label}.exit_code"' EXIT
if [[ "${PILOT_REPLOT_ONLY:-0}" != 1 ]]; then
/home/anaconda3/bin/python3 "${PILOT}/code/collect_pilot.py" --root "${PILOT}"
/usr/bin/time -v -o "${PILOT}/logs/diagnostics.time.txt" /home/anaconda3/bin/python3 \
  "${PILOT}/code/diagnose_ranges.py" --root "${PILOT}"
fi
/home/anaconda3/bin/python3 "${PILOT}/code/plot_pilot.py" \
  --root "${PILOT}" --campaign "${CAMPAIGN}"
/home/anaconda3/bin/python3 "${PILOT}/code/verify_pilot.py" \
  --root "${PILOT}" --campaign "${CAMPAIGN}"
/home/anaconda3/bin/python3 "${PILOT}/code/summarize_report.py" --root "${PILOT}"
