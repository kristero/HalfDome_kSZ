#!/bin/bash
#PBS -N SO2p_NSF
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=64gb
#PBS -l walltime=24:00:00
#PBS -o /home/kristero10/logs/SBI_runs/
#PBS -e /home/kristero10/logs/SBI_runs/
#PBS -S /bin/bash

set -euo pipefail

WORK_DIR="${PBS_O_WORKDIR:-$PWD}"
cd "${WORK_DIR}"
: "${PROJECT_ROOT:=${WORK_DIR}}"
: "${PYTHON:=python3}"
: "${PYTHON_ENV_SETUP:=}"
: "${PREPARED_DATASET:=/home/kristero10/HalfDome_kSZ/SBI_analysis/data_for_cluster/adrian_so_sbi_cases_ell80_7979_dataset_row_sobolrow/so_masked_baseline_noise_cross_deproj0_ell80_7979_sbi_run.npz}"
: "${CONVERGENCE_ROOT:=/lustre/work/kristero10/adrian_two_param_nsf_convergence_baseline_deproj0}"
: "${N_TRAIN:?N_TRAIN must be supplied by submit_so_two_param_nsf_convergence.sh}"
: "${X_RESCALE_MODE:=asinh}"
: "${HOLDOUT_LAST_N:=1000}"
: "${HIDDEN_FEATURES:=64}"
: "${NUM_TRANSFORMS:=6}"
: "${NUM_BINS:=10}"
: "${STOP_AFTER_EPOCHS:=60}"
: "${NUM_POSTERIOR_SAMPLES:=2000}"
: "${BATTAGLIA_SIZES:=256,32768,523288}"
: "${NUM_BATTAGLIA_SAMPLES:=20000}"
: "${SBI_SEED:=42}"
: "${SBI_DEVICE:=cpu}"
: "${OVERWRITE:=0}"

case "${X_RESCALE_MODE}" in
  asinh) ;;
  *) echo "This convergence workflow only supports asinh; got ${X_RESCALE_MODE}." >&2; exit 2 ;;
esac
[[ "${N_TRAIN}" =~ ^[0-9]+$ ]] || { echo "N_TRAIN must be an integer." >&2; exit 2; }

TRAIN_SCRIPT="${PROJECT_ROOT}/SBI_analysis/train_so_two_param_npe.py"
EVAL_SCRIPT="${PROJECT_ROOT}/SBI_analysis/evaluate_so_two_param_nsf_convergence_run.py"
RUN_DIR="${CONVERGENCE_ROOT}/${X_RESCALE_MODE}/N${N_TRAIN}"
EVALUATION_DIR="${RUN_DIR}/evaluation"

for path in "${TRAIN_SCRIPT}" "${EVAL_SCRIPT}" "${PREPARED_DATASET}"; do
  [[ -f "${path}" ]] || { echo "Required input not found: ${path}" >&2; exit 2; }
done
mkdir -p /home/kristero10/logs/SBI_runs "${RUN_DIR}" "${EVALUATION_DIR}"

if [[ -n "${PYTHON_ENV_SETUP}" ]]; then
  eval "${PYTHON_ENV_SETUP}"
fi

ALLOCATED_CPUS="${PBS_NCPUS:-26}"
export OMP_NUM_THREADS="${ALLOCATED_CPUS}"
export OPENBLAS_NUM_THREADS="${ALLOCATED_CPUS}"
export MKL_NUM_THREADS="${ALLOCATED_CPUS}"
export NUMEXPR_NUM_THREADS="${ALLOCATED_CPUS}"
export TORCH_NUM_THREADS="${ALLOCATED_CPUS}"
export TORCH_NUM_INTEROP_THREADS=1

echo "Started: $(date -Is)"
echo "N_train=${N_TRAIN}, mode=${X_RESCALE_MODE}, estimator=NSF"
echo "NSF hidden_features=${HIDDEN_FEATURES}, num_transforms=${NUM_TRANSFORMS}, num_bins=${NUM_BINS}"
echo "The NSF context input is the 40-bin D_ell vector."
echo "Run directory: ${RUN_DIR}"
"${PYTHON}" --version

if [[ "${OVERWRITE}" == "1" || ! -f "${RUN_DIR}/density_estimator.pkl" || ! -f "${RUN_DIR}/run_metadata.json" ]]; then
  TRAIN_EXTRA=()
  if [[ "${OVERWRITE}" == "1" || -f "${RUN_DIR}/density_estimator.pkl" ]]; then
    TRAIN_EXTRA+=(--overwrite)
  fi
  "${PYTHON}" "${TRAIN_SCRIPT}" \
    --prepared-dataset "${PREPARED_DATASET}" \
    --output-dir "${RUN_DIR}" \
    --target-params P0,beta \
    --holdout-last-n "${HOLDOUT_LAST_N}" \
    --n-train "${N_TRAIN}" \
    --dataset-order shuffle \
    --x-rescale-mode "${X_RESCALE_MODE}" \
    --density-estimator nsf \
    --internal-z-score-x none \
    --hidden-features "${HIDDEN_FEATURES}" \
    --num-transforms "${NUM_TRANSFORMS}" \
    --num-bins "${NUM_BINS}" \
    --stop-after-epochs "${STOP_AFTER_EPOCHS}" \
    --num-battaglia-samples 0 \
    --seed "${SBI_SEED}" \
    --device "${SBI_DEVICE}" \
    "${TRAIN_EXTRA[@]}"
else
  echo "Reusing completed density estimator: ${RUN_DIR}/density_estimator.pkl"
fi

BATTAGLIA_COUNT=0
case ",${BATTAGLIA_SIZES}," in
  *",${N_TRAIN},"*) BATTAGLIA_COUNT="${NUM_BATTAGLIA_SAMPLES}" ;;
esac

EVAL_EXTRA=()
[[ "${OVERWRITE}" == "1" ]] && EVAL_EXTRA+=(--restart)

"${PYTHON}" "${EVAL_SCRIPT}" \
  --prepared-dataset "${PREPARED_DATASET}" \
  --run-dir "${RUN_DIR}" \
  --mode "${X_RESCALE_MODE}" \
  --n-train "${N_TRAIN}" \
  --holdout-last-n "${HOLDOUT_LAST_N}" \
  --num-posterior-samples "${NUM_POSTERIOR_SAMPLES}" \
  --rank-bins 20 \
  --battaglia-samples "${BATTAGLIA_COUNT}" \
  --battaglia-batch-size 2000 \
  --checkpoint-every 5 \
  --seed "${SBI_SEED}" \
  --device "${SBI_DEVICE}" \
  "${EVAL_EXTRA[@]}"

echo "Finished: $(date -Is)"
echo "Completion marker: ${EVALUATION_DIR}/evaluation_complete.json"
