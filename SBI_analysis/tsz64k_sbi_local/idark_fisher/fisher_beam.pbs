#!/bin/bash
#PBS -N fb_fbeam
#PBS -j oe
# Fisher forecast at B12 with the beam-consistent noise (fisher_forecast_b12.py --beam), Merlin's inputs those of
# merlin_w420_prepare.py (results_merlin_unbinned_beam_w420/inputs).
#   qsub -q mini_B -l select=1:ncpus=8:mem=48gb -l walltime=02:00:00 [-v OUT=results_beam,LAGS=64,HALF=25] fisher_beam.pbs
set -uo pipefail
R=$HOME/tsz64k_fisher_b12_20261002; cd $R
L=$HOME/sbi_reruns_20261001/SBI_analysis/tsz64k_sbi_local
W=$L/results_merlin_unbinned_beam_w420/inputs
OUT=${OUT:-results_beam}
exec > logs/fisher_${OUT}_${PBS_JOBID%%.*}.log 2>&1
C=${NCPUS:-8}
export OMP_NUM_THREADS=$C OPENBLAS_NUM_THREADS=$C MKL_NUM_THREADS=$C PYTHONUNBUFFERED=1
echo "host=$(hostname) ncpus=$C start=$(date -Is) lags=${LAGS:-64} half=${HALF:-25}"
/home/kristero10/envs/sbi27/bin/python fisher_forecast_b12.py --inputs inputs --root $R --out $OUT \
  --lags ${LAGS:-64} --half ${HALF:-25} --beam --merlin-whitening $W/whitening_pca.npz --merlin-b12 $W/b12.npz
code=$?; echo "finished=$(date -Is) code=$code"; exit $code
