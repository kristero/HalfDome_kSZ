/home/anaconda3/bin/python3 "$STUDY_ROOT/code/mean_y.py" --root "$STUDY_ROOT"
/home/anaconda3/bin/python3 "$STUDY_ROOT/code/los_support.py" --root "$STUDY_ROOT"
