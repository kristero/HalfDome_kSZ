 "files_read_note": "List = every file the smoke run opened (Python audit hook, recorded in results_smoke/run_manifest.json) outside F_observables and the Python installation, with byte-code caches replaced by their .py sources, plus kernels/jacobians.npz (read only by --full) and radii234 fit_study.py (imported by sensitivity analysis_common). Absolute paths are the current local ones; 'relative_to_STUDY_ROOT' is what the code actually uses. No file outside F_observables/results is written.",
 "python": {
  "tested": "CPython 3.11 (flamingo env)",
  "packages": {
   "numpy": "2.2.6 (>= 2.0)",
   "scipy": "1.17.1 (>= 1.11; 1.17 uses CODATA 2022 sigma_T/m_e, a 1.1e-8 relative shift that cancels in every ratio reported)",
   "matplotlib": "3.11.2 (imported with the Agg backend by the frozen engine modules; no figures are made on the cluster)"
  },
  "threads": "OMP/OpenBLAS/MKL threads are forced to 1 inside the code; parallelism = --workers forked processes"
 },
 "expected_resources_workers_4": {
