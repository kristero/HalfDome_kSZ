#!/bin/bash
#PBS -N lee22full_obs
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=64gb
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o /lustre/work/kristero10/lee22_full_observation_20261001/logs/
#PBS -S /bin/bash
set -euo pipefail
: "${LEE22_SHA256:?set LEE22_SHA256}"
mkdir -p /lustre/work/kristero10/lee22_full_observation_20261001/logs
export PYTHONUNBUFFERED=1
exec /home/anaconda3/bin/python3 /lustre/work/kristero10/lee22_full_observation_20261001/code/run_full_lee22_observation.py "${LEE22_SHA256}"
