#!/bin/bash
#PBS -N FLAM_tSZ_SBI
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=64gb
#PBS -l walltime=23:59:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
: "${CAMPAIGN:?Set CAMPAIGN}"
export OMP_NUM_THREADS=26 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONUNBUFFERED=1 HDF5_USE_FILE_LOCKING=FALSE MPLBACKEND=Agg
exec > "${CAMPAIGN}/logs/campaign.log" 2>&1
trap 'status=$?; printf "%s\n" "$status" > "${CAMPAIGN}/logs/campaign.exit_code"' EXIT
/home/anaconda3/bin/python3 "${CAMPAIGN}/code/run_campaign.py" --campaign "${CAMPAIGN}"
