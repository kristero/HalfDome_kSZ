set -euo pipefail
STUDY_ROOT="${STUDY_ROOT:-/lustre/work/kristero10/tsz_guardrail_study_20260915}"
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=1 HDF5_USE_FILE_LOCKING=FALSE
