#PBS -N tSZ_sbi_battaglia9
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=128gb
#PBS -l walltime=23:59:00
#PBS -o /home/kristero10/logs/tSZ_baryon_run/
#PBS -e /home/kristero10/logs/tSZ_baryon_run/
#PBS -S /bin/bash

set -euo pipefail

cd "${PBS_O_WORKDIR:-$PWD}"

: "${PYTHON:=python3}"
: "${PYTHON_ENV_SETUP:=}"
: "${LOG_DIR:=/home/kristero10/logs/tSZ_baryon_run}"
: "${OMP_NUM_THREADS:=1}"
: "${OPENBLAS_NUM_THREADS:=1}"
: "${MKL_NUM_THREADS:=1}"

SCRIPT_CANDIDATE_1="${PBS_O_WORKDIR}/train_sbi.py"
SCRIPT_CANDIDATE_2="${PBS_O_WORKDIR}/SBI_analysis/train_sbi.py"
SCRIPT_CANDIDATE_3="${PBS_O_WORKDIR}/../SBI_analysis/train_sbi.py"
if [[ -f "${SCRIPT_CANDIDATE_1}" ]]; then
  SCRIPT="${SCRIPT_CANDIDATE_1}"
elif [[ -f "${SCRIPT_CANDIDATE_2}" ]]; then
  SCRIPT="${SCRIPT_CANDIDATE_2}"
elif [[ -f "${SCRIPT_CANDIDATE_3}" ]]; then
  SCRIPT="${SCRIPT_CANDIDATE_3}"
else
  echo "Could not locate train_sbi.py from PBS_O_WORKDIR=${PBS_O_WORKDIR}" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${SCRIPT}")" && pwd)"
: "${CONFIG:=${SCRIPT_DIR}/configs/default_cluster.json}"
: "${OUTPUT_DIR:=}"
: "${OBSERVED_SPECTRUM_PATH:=}"

mkdir -p "${LOG_DIR}"

if [[ -n "${PYTHON_ENV_SETUP}" ]]; then
  echo "Running Python environment setup command."
  eval "${PYTHON_ENV_SETUP}"
fi

export OMP_NUM_THREADS
export OPENBLAS_NUM_THREADS
export MKL_NUM_THREADS

JOB_ID="${PBS_JOBID:-manual}"
ALLOCATED_CPUS_HINT="${PBS_NCPUS:-${NCPUS:-unknown}}"
PBS_NP_HINT="${PBS_NP:-unknown}"
NODEFILE_SLOTS="unknown"
if [[ -n "${PBS_NODEFILE:-}" && -f "${PBS_NODEFILE}" ]]; then
  NODEFILE_SLOTS="$(wc -l < "${PBS_NODEFILE}")"
fi

echo "======================================="
echo "PBS job id: ${JOB_ID}"
echo "Working directory: ${PBS_O_WORKDIR:-NA}"
echo "Host: $(hostname)"
echo "Date: $(date -Is)"
echo "Python script: ${SCRIPT}"
echo "Python executable: ${PYTHON}"
"${PYTHON}" --version
echo "Config: ${CONFIG}"
echo "Output override: ${OUTPUT_DIR:-<config>}"
echo "Observed spectrum override: ${OBSERVED_SPECTRUM_PATH:-<config>}"
echo "PBS_NP: ${PBS_NP_HINT}"
echo "PBS_NCPUS/NCPUS: ${ALLOCATED_CPUS_HINT}"
echo "PBS nodefile slots: ${NODEFILE_SLOTS}"
echo "OMP_NUM_THREADS: ${OMP_NUM_THREADS}"
echo "OPENBLAS_NUM_THREADS: ${OPENBLAS_NUM_THREADS}"
echo "MKL_NUM_THREADS: ${MKL_NUM_THREADS}"
if [[ -n "${PBS_NODEFILE:-}" && -f "${PBS_NODEFILE}" ]]; then
  echo "PBS node allocation:"
  sort "${PBS_NODEFILE}" | uniq -c
fi
command -v taskset >/dev/null 2>&1 && taskset -pc $$
command -v lscpu >/dev/null 2>&1 && lscpu | egrep 'Model name|CPU\\(s\\)|Thread|Core|Socket|MHz|NUMA'
echo "======================================="

"${PYTHON}" - <<'PY'
import importlib.util
import sys

required = ["numpy", "matplotlib", "torch", "sbi", "sklearn", "joblib"]
missing = [name for name in required if importlib.util.find_spec(name) is None]
has_fits_reader = importlib.util.find_spec("astropy") is not None or importlib.util.find_spec("fitsio") is not None
if not has_fits_reader:
    missing.append("astropy or fitsio")
if missing:
    print("Missing Python packages: " + ", ".join(missing), file=sys.stderr)
    print("Load/activate an environment with sbi, torch, scikit-learn, joblib, matplotlib, numpy, and a FITS reader.", file=sys.stderr)
    raise SystemExit(1)
PY

set -- --config "${CONFIG}"
if [[ -n "${OUTPUT_DIR}" ]]; then
  set -- "$@" --output-dir "${OUTPUT_DIR}"
fi
if [[ -n "${OBSERVED_SPECTRUM_PATH}" ]]; then
  set -- "$@" --observed-spectrum-path "${OBSERVED_SPECTRUM_PATH}"
fi

"${PYTHON}" "${SCRIPT}" "$@" \
  > "${LOG_DIR}/tSZ_sbi_battaglia9_${JOB_ID}.out" \
  2> "${LOG_DIR}/tSZ_sbi_battaglia9_${JOB_ID}.err"

echo "Job finished."
