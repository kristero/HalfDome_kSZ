#!/bin/bash
#PBS -N seed_bias_report
#PBS -q mini2
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=48gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
ROOT=/lustre/work/kristero10/tsz_seed_offset_diagnosis_20261005
cd "$ROOT"
exec > "logs/finalize_${PBS_JOBID%%.*}.log" 2>&1
export OMP_NUM_THREADS=26 OPENBLAS_NUM_THREADS=26 MKL_NUM_THREADS=26
export MERLIN_PARAM_SPACE=linear MPLBACKEND=Agg
echo "host=$(hostname) start=$(date -Is)"
PYTHON=/home/kristero10/envs/sbi27/bin/python
/usr/bin/time -v -o "logs/finalize_resources_${PBS_JOBID%%.*}.txt" \
 "$PYTHON" extended_controls.py --root "$ROOT" --threads 26 --append-mask-means
"$PYTHON" make_report.py --root "$ROOT"
echo "finished=$(date -Is)"
