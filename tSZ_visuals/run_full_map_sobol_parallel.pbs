#PBS -N tSZ_sobol512_split
#PBS -q mini
#PBS -l select=1:ncpus=25:mpiprocs=1:mem=20gb
#PBS -l walltime=23:59:00
#PBS -o /home/kristero10/logs/tSZ_baryon_run/
#PBS -e /home/kristero10/logs/tSZ_baryon_run/
#PBS -S /bin/bash

set -euo pipefail

cd "$PBS_O_WORKDIR"

: "${JULIA:=/usr/local/bin/julia}"
: "${LIGHTCONE_ID:=100}"
: "${SOBOL_SPLIT:=1}"
: "${LOG_DIR:=/home/kristero10/logs/tSZ_baryon_run}"
: "${SOBOL_CSV:=/home/kristero10/tSZ_data/battaglia_sobol_512_${SOBOL_SPLIT}.csv}"
: "${HALFDOME_PATH:=/lustre/work/Globus-lt/halfdome/full_res/halos/lightcone_${LIGHTCONE_ID}.hdf5}"
: "${OUTPUT_DIR:=/lustre/work/kristero10/tSZ_data/y${LIGHTCONE_ID}}"
: "${CACHE_DIR:=/lustre/work/kristero10/tSZ_data/cache}"
: "${SIMULATION_NAME:=halfdome_lightcone_${LIGHTCONE_ID}}"
: "${NSIDE:=4096}"
: "${THREADS_PER_TASK:=26}"
: "${MAX_PARALLEL:=1}"
: "${MODEL_EXISTS:=false}"
: "${REUSE_EXISTING_CACHE:=false}"
: "${CACHE_WAIT_SECONDS:=0}"
: "${CACHE_POLL_SECONDS:=30}"
: "${INTERPOLATOR_PAD:=256}"
: "${INTERPOLATOR_LOGM_MAX:=15.7}"
: "${INTERPOLATOR_TIMEOUT_SECONDS:=700}"
: "${CL_LMAX:=4096}"
: "${CL_NITER:=0}"
: "${SKIP_EXISTING_OUTPUTS:=false}"
: "${SKIP_EXISTING_ANY_RUN_INSTANCE:=true}"
: "${RUN_INSTANCE_TAG:=pbsjob${PBS_JOBID:-manual}}"
: "${ENFORCE_BATTAGLIA_GUARDRAILS:=true}"
: "${SKIP_INVALID_BATTAGLIA_ROWS:=true}"
: "${CONTINUE_ON_ROW_ERROR:=true}"
: "${PRINT_RUNTIME_ENVIRONMENT:=false}"
: "${REDO_LOG:=${LOG_DIR}/tSZ_sobol_redo_${PBS_JOBID:-manual}.log}"
: "${OMP_NUM_THREADS:=1}"
: "${OPENBLAS_NUM_THREADS:=1}"
: "${MKL_NUM_THREADS:=1}"

SCRIPT_CANDIDATE_1="${PBS_O_WORKDIR}/run_full_map.jl"
SCRIPT_CANDIDATE_2="${PBS_O_WORKDIR}/tSZ_visuals/run_full_map.jl"
if [[ -f "${SCRIPT_CANDIDATE_1}" ]]; then
  SCRIPT="${SCRIPT_CANDIDATE_1}"
elif [[ -f "${SCRIPT_CANDIDATE_2}" ]]; then
  SCRIPT="${SCRIPT_CANDIDATE_2}"
else
  echo "Could not locate run_full_map.jl from PBS_O_WORKDIR=${PBS_O_WORKDIR}" >&2
  exit 1
fi

BUILD_SCRIPT_CANDIDATE_1="${PBS_O_WORKDIR}/build_interpolator_cache.jl"
BUILD_SCRIPT_CANDIDATE_2="${PBS_O_WORKDIR}/tSZ_visuals/build_interpolator_cache.jl"
if [[ -f "${BUILD_SCRIPT_CANDIDATE_1}" ]]; then
  BUILD_SCRIPT="${BUILD_SCRIPT_CANDIDATE_1}"
elif [[ -f "${BUILD_SCRIPT_CANDIDATE_2}" ]]; then
  BUILD_SCRIPT="${BUILD_SCRIPT_CANDIDATE_2}"
else
  echo "Could not locate build_interpolator_cache.jl from PBS_O_WORKDIR=${PBS_O_WORKDIR}" >&2
  exit 1
fi

mkdir -p "${LOG_DIR}" "${OUTPUT_DIR}" "${CACHE_DIR}"
: > "${REDO_LOG}"

export OMP_NUM_THREADS
export OPENBLAS_NUM_THREADS
export MKL_NUM_THREADS
export ENFORCE_BATTAGLIA_GUARDRAILS
export SKIP_INVALID_BATTAGLIA_ROWS

ROW_COUNT="$(awk 'END {print NR-1}' "${SOBOL_CSV}")"

if [[ "${ROW_COUNT}" -lt 1 ]]; then
  echo "Sobol CSV has no data rows: ${SOBOL_CSV}" >&2
  exit 1
fi
: "${SOBOL_ROW_START:=1}"
: "${SOBOL_ROW_STOP:=${ROW_COUNT}}"
if [[ "${SOBOL_ROW_START}" -lt 1 ]]; then
  echo "SOBOL_ROW_START must be >= 1, got ${SOBOL_ROW_START}" >&2
  exit 1
fi
if [[ "${SOBOL_ROW_STOP}" -lt "${SOBOL_ROW_START}" ]]; then
  echo "SOBOL_ROW_STOP must be >= SOBOL_ROW_START, got ${SOBOL_ROW_STOP} < ${SOBOL_ROW_START}" >&2
  exit 1
fi
if [[ "${SOBOL_ROW_STOP}" -gt "${ROW_COUNT}" ]]; then
  echo "SOBOL_ROW_STOP=${SOBOL_ROW_STOP} exceeds Sobol row count ${ROW_COUNT}" >&2
  exit 1
fi
REQUESTED_ROW_COUNT=$(( SOBOL_ROW_STOP - SOBOL_ROW_START + 1 ))

if [[ "${REQUESTED_ROW_COUNT}" -lt "${MAX_PARALLEL}" ]]; then
  CONCURRENT_JOBS="${REQUESTED_ROW_COUNT}"
else
  CONCURRENT_JOBS="${MAX_PARALLEL}"
fi
if [[ "${CONCURRENT_JOBS}" -gt 1 && "${THREADS_PER_TASK}" -eq 26 ]]; then
  THREADS_PER_TASK=$(( 26 / CONCURRENT_JOBS ))
  if [[ "${THREADS_PER_TASK}" -lt 1 ]]; then
    THREADS_PER_TASK=1
  fi
fi

ALLOCATED_CPUS_HINT="${PBS_NCPUS:-${NCPUS:-unknown}}"
PBS_NP_HINT="${PBS_NP:-unknown}"
NODEFILE_SLOTS="unknown"
if [[ -n "${PBS_NODEFILE:-}" && -f "${PBS_NODEFILE}" ]]; then
  NODEFILE_SLOTS="$(wc -l < "${PBS_NODEFILE}")"
fi

echo "======================================="
echo "PBS job id: ${PBS_JOBID:-NA}"
echo "Working directory: ${PBS_O_WORKDIR:-NA}"
echo "Nodefile: ${PBS_NODEFILE:-NA}"
echo "Host: $(hostname)"
echo "Date: $(date -Is)"
echo "Julia script: ${SCRIPT}"
echo "Interpolator build script: ${BUILD_SCRIPT}"
echo "Julia executable: ${JULIA}"
"${JULIA}" --version
echo "Lightcone id: ${LIGHTCONE_ID}"
echo "Simulation name: ${SIMULATION_NAME}"
echo "Sobol split: ${SOBOL_SPLIT}"
echo "Sobol CSV: ${SOBOL_CSV}"
echo "Sobol rows: ${ROW_COUNT}"
echo "Sobol row range for this job: ${SOBOL_ROW_START}:${SOBOL_ROW_STOP}"
echo "PBS_NP/nodefile slots are MPI slots on this cluster, not OpenMP thread count."
echo "PBS_NP: ${PBS_NP_HINT}"
echo "PBS_NCPUS/NCPUS: ${ALLOCATED_CPUS_HINT}"
echo "PBS nodefile slots: ${NODEFILE_SLOTS}"
echo "Concurrent Julia tasks: ${CONCURRENT_JOBS}"
echo "Threads per Julia task: ${THREADS_PER_TASK}"
"${JULIA}" --threads="${THREADS_PER_TASK}" -e 'println("Julia preflight nthreads=", Base.Threads.nthreads())'
echo "OMP_NUM_THREADS: ${OMP_NUM_THREADS}"
echo "OPENBLAS_NUM_THREADS: ${OPENBLAS_NUM_THREADS}"
echo "MKL_NUM_THREADS: ${MKL_NUM_THREADS}"
if [[ -n "${PBS_NODEFILE:-}" && -f "${PBS_NODEFILE}" ]]; then
  echo "PBS node allocation:"
  sort "${PBS_NODEFILE}" | uniq -c
fi
command -v taskset >/dev/null 2>&1 && taskset -pc $$
command -v lscpu >/dev/null 2>&1 && lscpu | egrep 'Model name|CPU\\(s\\)|Thread|Core|Socket|MHz|NUMA'
echo "======================================="

echo "Running full Sobol sequence"
echo "simulation_name=${SIMULATION_NAME}"
echo "halfdome_path=${HALFDOME_PATH}"
echo "output_dir=${OUTPUT_DIR}"
echo "cache_dir=${CACHE_DIR}"
echo "apply_gaussian_beam=false"
echo "model_exists=${MODEL_EXISTS}"
echo "reuse_existing_cache=${REUSE_EXISTING_CACHE}"
echo "cache_wait_seconds=${CACHE_WAIT_SECONDS}"
echo "cache_poll_seconds=${CACHE_POLL_SECONDS}"
echo "interpolator_pad=${INTERPOLATOR_PAD}"
echo "interpolator_logM_max=${INTERPOLATOR_LOGM_MAX}"
echo "interpolator_timeout_seconds=${INTERPOLATOR_TIMEOUT_SECONDS}"
echo "cl_lmax=${CL_LMAX}"
echo "cl_niter=${CL_NITER}"
echo "skip_existing_outputs=${SKIP_EXISTING_OUTPUTS}"
echo "skip_existing_any_run_instance=${SKIP_EXISTING_ANY_RUN_INSTANCE}"
echo "run_instance_tag=${RUN_INSTANCE_TAG}"
echo "enforce_battaglia_guardrails=${ENFORCE_BATTAGLIA_GUARDRAILS}"
echo "skip_invalid_battaglia_rows=${SKIP_INVALID_BATTAGLIA_ROWS}"
echo "continue_on_row_error=${CONTINUE_ON_ROW_ERROR}"
echo "redo_log=${REDO_LOG}"

is_true() {
  case "${1:-}" in
    true|TRUE|True|1|yes|YES|Yes|y|Y|on|ON|On) return 0 ;;
    *) return 1 ;;
  esac
}

log_redo_required() {
  local sobol_row="$1"
  local reason="$2"
  local detail="${3:-}"
  local message
  message="REDO_REQUIRED lightcone=${LIGHTCONE_ID} split=${SOBOL_SPLIT} sobol_row=${sobol_row} reason=${reason}"
  if [[ -n "${detail}" ]]; then
    message+=" ${detail}"
  fi
  echo "${message}"
  echo "${message}" >> "${REDO_LOG}"
}

run_julia_row_script() {
  local script_path="$1"
  local sobol_row="$2"
  local model_exists_value="$3"
  local print_summary_value="$4"

  "${JULIA}" --threads="${THREADS_PER_TASK}" "${script_path}" \
    catalog_source=halfdome \
    simulation_name="${SIMULATION_NAME}" \
    batching_mode=full \
    save_healpix_map=false \
    save_bin_maps=false \
    save_mass_map=false \
    save_cl=true \
    nside="${NSIDE}" \
    model_exists="${model_exists_value}" \
    reuse_existing_cache="${REUSE_EXISTING_CACHE}" \
    cache_wait_seconds="${CACHE_WAIT_SECONDS}" \
    cache_poll_seconds="${CACHE_POLL_SECONDS}" \
    interpolator_pad="${INTERPOLATOR_PAD}" \
    interpolator_logM_max="${INTERPOLATOR_LOGM_MAX}" \
    cl_lmax="${CL_LMAX}" \
    cl_niter="${CL_NITER}" \
    skip_existing_outputs="${SKIP_EXISTING_OUTPUTS}" \
    skip_existing_any_run_instance="${SKIP_EXISTING_ANY_RUN_INSTANCE}" \
    enforce_battaglia_guardrails="${ENFORCE_BATTAGLIA_GUARDRAILS}" \
    skip_invalid_battaglia_rows="${SKIP_INVALID_BATTAGLIA_ROWS}" \
    sobol_csv_path="${SOBOL_CSV}" \
    sobol_row="${sobol_row}" \
    apply_gaussian_beam=false \
    halfdome_path="${HALFDOME_PATH}" \
    output_dir="${OUTPUT_DIR}" \
    cache_dir="${CACHE_DIR}" \
    run_instance_tag="${RUN_INSTANCE_TAG}" \
    print_run_summary="${print_summary_value}" \
    print_runtime_environment="${PRINT_RUNTIME_ENVIRONMENT}"
}

run_interpolator_step() {
  local sobol_row="$1"
  local status

  echo "Building interpolator for sobol_row=${sobol_row}; timeout=${INTERPOLATOR_TIMEOUT_SECONDS}s."
  if [[ "${INTERPOLATOR_TIMEOUT_SECONDS}" != "0" ]] && command -v timeout >/dev/null 2>&1; then
    timeout "${INTERPOLATOR_TIMEOUT_SECONDS}s" "${JULIA}" --threads="${THREADS_PER_TASK}" "${BUILD_SCRIPT}" \
      catalog_source=halfdome \
      simulation_name="${SIMULATION_NAME}" \
      batching_mode=full \
      save_healpix_map=false \
      save_bin_maps=false \
      save_mass_map=false \
      save_cl=true \
      nside="${NSIDE}" \
      model_exists=false \
      reuse_existing_cache="${REUSE_EXISTING_CACHE}" \
      cache_wait_seconds="${CACHE_WAIT_SECONDS}" \
      cache_poll_seconds="${CACHE_POLL_SECONDS}" \
      interpolator_pad="${INTERPOLATOR_PAD}" \
      interpolator_logM_max="${INTERPOLATOR_LOGM_MAX}" \
      cl_lmax="${CL_LMAX}" \
      cl_niter="${CL_NITER}" \
      skip_existing_outputs="${SKIP_EXISTING_OUTPUTS}" \
      skip_existing_any_run_instance="${SKIP_EXISTING_ANY_RUN_INSTANCE}" \
      enforce_battaglia_guardrails="${ENFORCE_BATTAGLIA_GUARDRAILS}" \
      skip_invalid_battaglia_rows="${SKIP_INVALID_BATTAGLIA_ROWS}" \
      sobol_csv_path="${SOBOL_CSV}" \
      sobol_row="${sobol_row}" \
      apply_gaussian_beam=false \
      halfdome_path="${HALFDOME_PATH}" \
      output_dir="${OUTPUT_DIR}" \
      cache_dir="${CACHE_DIR}" \
      run_instance_tag="${RUN_INSTANCE_TAG}" \
      print_run_summary=true \
      print_runtime_environment="${PRINT_RUNTIME_ENVIRONMENT}"
    status=$?
  else
    if [[ "${INTERPOLATOR_TIMEOUT_SECONDS}" != "0" ]]; then
      echo "timeout command unavailable; running interpolator build without a wall-clock limit."
    fi
    run_julia_row_script "${BUILD_SCRIPT}" "${sobol_row}" "false" "true"
    status=$?
  fi

  return "${status}"
}

run_one_row() {
  local sobol_row="$1"
  local build_status=0
  local run_status=0
  local full_run_model_exists="${MODEL_EXISTS}"
  local full_run_print_summary="true"

  set +e
  export JULIA_NUM_THREADS="${THREADS_PER_TASK}"
  echo "Row start: lightcone=${LIGHTCONE_ID}, split=${SOBOL_SPLIT}, sobol_row=${sobol_row}, threads=${THREADS_PER_TASK}."

  if ! is_true "${MODEL_EXISTS}"; then
    run_interpolator_step "${sobol_row}"
    build_status=$?
    if [[ "${build_status}" -eq 124 || "${build_status}" -eq 137 || "${build_status}" -eq 143 ]]; then
      log_redo_required "${sobol_row}" "interpolator_timeout" "limit_seconds=${INTERPOLATOR_TIMEOUT_SECONDS}"
      return 0
    elif [[ "${build_status}" -ne 0 ]]; then
      log_redo_required "${sobol_row}" "interpolator_build_failed" "exit_status=${build_status}"
      is_true "${CONTINUE_ON_ROW_ERROR}" && return 0
      return "${build_status}"
    fi

    full_run_model_exists="true"
    full_run_print_summary="false"
  fi

  echo "Running full-map pass for sobol_row=${sobol_row}."
  run_julia_row_script "${SCRIPT}" "${sobol_row}" "${full_run_model_exists}" "${full_run_print_summary}"
  run_status=$?
  if [[ "${run_status}" -ne 0 ]]; then
    log_redo_required "${sobol_row}" "full_map_failed" "exit_status=${run_status}"
    is_true "${CONTINUE_ON_ROW_ERROR}" && return 0
    return "${run_status}"
  fi

  echo "Row finished: sobol_row=${sobol_row}."
  return 0
}

row="${SOBOL_ROW_START}"
while [[ "${row}" -le "${SOBOL_ROW_STOP}" ]]; do
  pids=()
  batch_rows=()

  for ((slot = 0; slot < CONCURRENT_JOBS && row <= SOBOL_ROW_STOP; slot++)); do
    row_tag="$(printf '%04d' "${row}")"
    stdout_path="${LOG_DIR}/tSZ_sobol_row${row_tag}_${PBS_JOBID:-manual}.out"
    stderr_path="${LOG_DIR}/tSZ_sobol_row${row_tag}_${PBS_JOBID:-manual}.err"

    echo "Launching sobol_row=${row} with ${THREADS_PER_TASK} threads"
    run_one_row "${row}" > "${stdout_path}" 2> "${stderr_path}" &

    pids+=("$!")
    batch_rows+=("${row}")
    row=$((row + 1))
  done

  for idx in "${!pids[@]}"; do
    if ! wait "${pids[$idx]}"; then
      failed_row="${batch_rows[$idx]}"
      echo "Sobol row ${failed_row} failed. Check ${LOG_DIR}/tSZ_sobol_row$(printf '%04d' "${failed_row}")_${PBS_JOBID:-manual}.err" >&2
      exit 1
    fi
  done
done

if [[ -s "${REDO_LOG}" ]]; then
  redo_count="$(wc -l < "${REDO_LOG}")"
  echo "Rows requiring redo: ${redo_count}. See ${REDO_LOG}"
fi

echo "Job finished."
