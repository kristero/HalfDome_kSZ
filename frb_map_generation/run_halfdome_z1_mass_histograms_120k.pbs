#!/bin/bash
#PBS -N frb_uniform_masspdf_120k
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=128gb
#PBS -l walltime=23:59:00
#PBS -S /bin/bash
#PBS -j oe

set -euo pipefail

# Draw 120,000 uniformly random HEALPix sightlines to a fixed source plane at
# z=1, then stream the complete HalfDome catalogue once. Every finite halo with
# 0 <= z_halo <= 1 is eligible for the requested foreground mass windows. The
# output is histogram-only: no sky map or per-ray DM matrix is written.

: "${PROJECT_DIR:=${PBS_O_WORKDIR:-$PWD}}"
: "${JULIA:=/usr/local/bin/julia}"
: "${PYTHON:=python3}"
: "${ENV_SETUP:=}"  # example: 'module load julia/1.8.5 python'
: "${LIGHTCONE_ID:=100}"
: "${CLUSTER_USER:=${USER:-kristero10}}"

# Inputs. Override either path with qsub -v when the cluster copy differs.
: "${HALFDOME_PATH:=/lustre/work/Globus-lt/halfdome/full_res/halos/lightcone_${LIGHTCONE_ID}.hdf5}"
: "${DM_CACHE:=${PROJECT_DIR}/frb_map_generation/outputs/shared_xgpaint_dm_cache.jld2}"

# Dedicated output tree; this does not reuse any previous output directory.
: "${OUTPUT_BASE:=/lustre/work/${CLUSTER_USER}/frb_data/halfdome_uniform_z1_120k_foreground_mass_histograms}"
: "${RUN_TAG:=zsrc1p0_n120000_seed42}"
OUTPUT_DIR="${OUTPUT_BASE}/${RUN_TAG}"
LOG_DIR="${OUTPUT_DIR}/logs"
HISTOGRAM_HDF5="${OUTPUT_DIR}/halfdome_uniform_z1_120k_foreground_mass_histograms.h5"
SUMMARY_CSV="${OUTPUT_DIR}/halfdome_uniform_z1_120k_foreground_mass_histograms_summary.csv"
PROVENANCE_TXT="${OUTPUT_DIR}/halfdome_uniform_z1_120k_foreground_mass_histograms_provenance.txt"

# Science settings.
: "${NFRB:=120000}"
: "${ZSOURCE:=1.0}"
: "${SEED:=42}"
: "${NSIDE:=4096}"
: "${DM_APERTURE_R200_MULTIPLIER:=1.0}"
: "${MASS_WINDOWS:=m1e10_to_1e12:1e10:1e12,m1e10_to_1e13:1e10:1e13,m1e10_to_1e14:1e10:1e14,m1e10_to_1e15:1e10:1e15,m1e10_to_1e16:1e10:1e16,m1e11_to_1e14:1e11:1e14,m1e12_to_1e14:1e12:1e14,m1e13_to_1e14:1e13:1e14,m1e12_to_1e16:1e12:1e16,m1e13_to_1e16:1e13:1e16,m1e14_to_1e16:1e14:1e16,m1e15_to_1e16:1e15:1e16}"

# Runtime and histogram settings.
: "${THREADS_PER_TASK:=26}"
: "${CHUNK_SIZE:=1000000}"
: "${PROGRESS_EVERY_BATCHES:=5}"
: "${PDF_EDGE_COUNT:=300}"
: "${PDF_DM_MIN:=0.1}"
: "${PDF_DM_MAX:=30000}"
: "${OVERWRITE:=false}"
: "${OMP_NUM_THREADS:=1}"
: "${OPENBLAS_NUM_THREADS:=1}"
: "${MKL_NUM_THREADS:=1}"

GENERATOR="${PROJECT_DIR}/frb_map_generation/generate_halfdome_z1_dm_mass_windows.jl"
PLOTTER="${PROJECT_DIR}/frb_map_generation/plot_halfdome_mass_window_histograms.py"
: "${JULIA_PROJECT:=}"  # empty reuses the cluster Julia environment

mkdir -p "${OUTPUT_DIR}" "${LOG_DIR}"
JOB_TAG="${PBS_JOBID:-manual}"
JOB_TAG="${JOB_TAG//[/_}"
JOB_TAG="${JOB_TAG//]/_}"
LOG_FILE="${LOG_DIR}/mass_histograms_${JOB_TAG}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

cd "${PROJECT_DIR}"
if [[ -n "${ENV_SETUP}" ]]; then
  echo "Running environment setup: ${ENV_SETUP}"
  eval "${ENV_SETUP}"
fi

missing_inputs=0
for required_file in "${HALFDOME_PATH}" "${DM_CACHE}" "${GENERATOR}" "${PLOTTER}"; do
  if [[ ! -f "${required_file}" ]]; then
    echo "Required file not found: ${required_file}" >&2
    missing_inputs=1
  fi
done
if [[ -n "${JULIA_PROJECT}" && ! -f "${JULIA_PROJECT}/Project.toml" ]]; then
  echo "Required file not found: ${JULIA_PROJECT}/Project.toml" >&2
  missing_inputs=1
fi
if (( missing_inputs != 0 )); then
  echo "One or more required inputs are missing; no halo processing was started." >&2
  exit 2
fi

export JULIA_NUM_THREADS="${THREADS_PER_TASK}"
export OMP_NUM_THREADS OPENBLAS_NUM_THREADS MKL_NUM_THREADS
run_julia() {
  if [[ -n "${JULIA_PROJECT}" ]]; then
    "${JULIA}" --project="${JULIA_PROJECT}" "$@"
  else
    "${JULIA}" "$@"
  fi
}
MASS_WINDOW_COUNT="$(awk -F',' '{print NF}' <<<"${MASS_WINDOWS}")"

echo "============================================================"
echo "HalfDome uniform 120k-ray foreground-mass histogram job"
echo "Date: $(date -Is)"
echo "Host: $(hostname)"
echo "PBS job id: ${PBS_JOBID:-NA}"
echo "Project: ${PROJECT_DIR}"
echo "Julia: ${JULIA}"
"${JULIA}" --version
"${JULIA}" -e 'VERSION >= v"1.6" || error("This workflow requires Julia 1.6 or newer; got $(VERSION)")'
echo "Python: ${PYTHON}"
"${PYTHON}" --version
echo "HalfDome catalog: ${HALFDOME_PATH}"
echo "DM cache: ${DM_CACHE}"
echo "Output directory: ${OUTPUT_DIR}"
echo "Shared rays: ${NFRB} unique uniform HEALPix pixels at z_source=${ZSOURCE}"
echo "Foreground halo interval: 0 <= z_halo <= ${ZSOURCE}"
echo "Mass windows (${MASS_WINDOW_COUNT}): ${MASS_WINDOWS}"
echo "Histogram: ${PDF_EDGE_COUNT} log edges over [${PDF_DM_MIN}, ${PDF_DM_MAX}] pc cm^-3"
echo "Per-ray DM output: false"
echo "============================================================"

# Fail before the expensive halo pass if the plotting environment is absent.
"${PYTHON}" -c 'import h5py, matplotlib, numpy'
run_julia -e 'using HDF5, Healpix, XGPaint'

run_julia --threads="${THREADS_PER_TASK}" "${GENERATOR}" \
  --catalog="${HALFDOME_PATH}" \
  --sightline-mode=uniform \
  --unique-pixels=true \
  --source-redshift="${ZSOURCE}" \
  --nfrb="${NFRB}" \
  --seed="${SEED}" \
  --nside="${NSIDE}" \
  --chunk-size="${CHUNK_SIZE}" \
  --progress-every-batches="${PROGRESS_EVERY_BATCHES}" \
  --mass-windows="${MASS_WINDOWS}" \
  --dm-cache="${DM_CACHE}" \
  --dm-cache-overwrite=false \
  --dm-aperture-r200-multiplier="${DM_APERTURE_R200_MULTIPLIER}" \
  --pdf-edge-count="${PDF_EDGE_COUNT}" \
  --pdf-spacing=log \
  --pdf-dm-min="${PDF_DM_MIN}" \
  --pdf-dm-max="${PDF_DM_MAX}" \
  --save-ray-dm=false \
  --output="${HISTOGRAM_HDF5}" \
  --summary="${SUMMARY_CSV}" \
  --provenance="${PROVENANCE_TXT}" \
  --overwrite="${OVERWRITE}"

"${PYTHON}" "${PLOTTER}" "${HISTOGRAM_HDF5}" --output-dir "${OUTPUT_DIR}"

# Assert that this is genuinely histogram-only and that all curves use the
# same requested ray count.
"${PYTHON}" - "${HISTOGRAM_HDF5}" "${NFRB}" "${MASS_WINDOW_COUNT}" <<'PY'
import sys
import h5py

path, expected_text, expected_windows_text = sys.argv[1:]
expected = int(expected_text)
expected_windows = int(expected_windows_text)
with h5py.File(path, "r") as handle:
    assert "dm_pc_cm3" not in handle, "Histogram-only file unexpectedly contains per-ray DM"
    assert "frb_pixel_ring_1based" not in handle, "Histogram-only file unexpectedly contains ray pixels"
    actual = int(handle.attrs["n_rays"])
    assert actual == expected, (actual, expected)
    assert handle["pdf_count"].shape == (expected_windows, 299), handle["pdf_count"].shape
    assert handle["pdf_density_per_pc_cm3"].shape == (expected_windows, 299)
    assert handle["foreground_halo_mass_histogram_count"].shape == (180,)
    assert handle["foreground_halo_redshift_histogram_count"].shape == (100,)
    sightline_mode = handle.attrs["provenance_sightline_mode"]
    if isinstance(sightline_mode, bytes):
        sightline_mode = sightline_mode.decode()
    assert str(sightline_mode) == "uniform"
    foreground = int(handle.attrs["provenance_foreground_valid_halo_count"])
    mass_accounted = (
        int(handle["foreground_halo_mass_histogram_count"][:].sum())
        + int(handle.attrs["provenance_foreground_mass_histogram_underflow_count"])
        + int(handle.attrs["provenance_foreground_mass_histogram_overflow_count"])
    )
    redshift_accounted = (
        int(handle["foreground_halo_redshift_histogram_count"][:].sum())
        + int(handle.attrs["provenance_foreground_redshift_histogram_underflow_count"])
        + int(handle.attrs["provenance_foreground_redshift_histogram_overflow_count"])
    )
    assert mass_accounted == foreground, (mass_accounted, foreground)
    assert redshift_accounted == foreground, (redshift_accounted, foreground)
print(
    f"Validated {expected_windows} mass windows, {expected:,} uniform z=1 rays, "
    f"and {foreground:,} foreground halos: {path}"
)
PY

echo "Completed successfully at $(date -Is)"
echo "Histogram HDF5: ${HISTOGRAM_HDF5}"
echo "Summary CSV: ${SUMMARY_CSV}"
echo "Provenance: ${PROVENANCE_TXT}"
echo "Figures and long-form bins: ${OUTPUT_DIR}"
