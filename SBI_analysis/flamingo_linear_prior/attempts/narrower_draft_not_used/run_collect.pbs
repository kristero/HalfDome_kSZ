#!/bin/bash
#PBS -N extended_collect
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=8gb
#PBS -l walltime=23:59:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
: "${RUN_ROOT:?Set RUN_ROOT}"
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=26
export PYTHONUNBUFFERED=1 HDF5_USE_FILE_LOCKING=FALSE
exec /home/anaconda3/bin/python3 "${RUN_ROOT}/code/collect.py" --root "${RUN_ROOT}"
