#!/bin/bash
#PBS -N robust_sky
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=64gb
#PBS -l walltime=23:59:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
: "${RUN_ROOT:?}" "${SIM_SEED:?}"
cd "$RUN_ROOT"
exec > "logs/paint_${SIM_SEED}_${PBS_JOBID%%.*}.log" 2>&1
STAGE=/home/kristero10/tsz64k_fixbeta_stage
JROOT="$STAGE/julia_tsz64k"
export HALFDOME_REPO="$RUN_ROOT/snapshot"
export JULIA_DEPOT_PATH="/home/kristero10/tsz64k_fixbeta_20260928/depot:$JROOT/depot"
export LD_LIBRARY_PATH="$JROOT/julia-1.12.2/lib/julia${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export JULIA_PKG_PRECOMPILE_AUTO=0 HDF5_USE_FILE_LOCKING=FALSE
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=26
echo "host=$(hostname) seed=$SIM_SEED start=$(date -Is)"
/usr/bin/time -v -o "logs/resources_${SIM_SEED}_${PBS_JOBID%%.*}.txt" \
 "$JROOT/julia-1.12.2/bin/julia" --startup-file=no --threads=26 \
 --project="$STAGE/HalfDome_kSZ/tSZ_64k_flat_prior_SO_baseline_deproj0/julia_env" \
 code/paint_seed.jl "tasks/seed_${SIM_SEED}.toml"
/home/kristero10/envs/sbi27/bin/python code/validate_grid.py --root "$RUN_ROOT" --seed "$SIM_SEED"
echo "finished=$(date -Is)"
