#!/bin/bash
#PBS -N frb_lee22_noc_z1
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=128gb
#PBS -l walltime=23:59:00
#PBS -S /bin/bash
#PBS -j oe

set -euo pipefail

# Controlled Lee et al. (2022) Appendix-A2 electron-density test:
#   - no halo-concentration dependence
#   - 120,000 identical uniform z_source=1 rays (seed 42)
#   - complete foreground HalfDome lightcone over 0 <= z_halo <= 1
#   - physical M200c profile input, M200c mass windows, and external 3R200c
#   - histogram-only output in a dedicated directory
#   - a dedicated signed cache that cannot be confused with Battaglia

: "${PROJECT_DIR:=/home/${USER}/HalfDome_kSZ}"
: "${CLUSTER_USER:=${USER}}"
: "${PYTHON:=python3}"
: "${OVERWRITE:=false}"
: "${DM_VALUE_SANITY_MAX:=1.0e8}"
: "${OUTPUT_BASE:=/lustre/work/${CLUSTER_USER}/frb_data/halfdome_lee2022_tablea2_noconcentration_z1_120k_foreground_mass_histograms}"
: "${RUN_TAG:=zsrc1p0_nside4096_nrays120000_allhalos_r200cx3p0_m200c_lee2022_tablea2_noconc_seed42}"
: "${DM_CACHE:=/lustre/work/${CLUSTER_USER}/frb_data/halfdome_frb_inputs/lee2022_tablea2_noconcentration_m200c_profile_owned_los_v2_dm_cache.jld2}"

export OUTPUT_BASE RUN_TAG DM_CACHE DM_VALUE_SANITY_MAX
PBS_LOG_DIR="${OUTPUT_BASE}/pbs_logs"
mkdir -p "${PBS_LOG_DIR}"
JOB_TAG="${PBS_JOBID:-manual}"
JOB_TAG="${JOB_TAG//[/_}"
JOB_TAG="${JOB_TAG//]/_}"
WRAPPER_LOG="${PBS_LOG_DIR}/lee2022_${JOB_TAG}.log"
exec > >(tee -a "${WRAPPER_LOG}") 2>&1
echo "Lee2022 wrapper log: ${WRAPPER_LOG}"

GENERIC_PBS="${PROJECT_DIR}/frb_map_generation/run_halfdome_z1_mass_histograms_120k.pbs"
PROFILE_FILE="${PROJECT_DIR}/frb_map_generation/lee2022_frb_dm_profile.jl"
GENERATOR="${PROJECT_DIR}/frb_map_generation/generate_halfdome_z1_dm_mass_windows.jl"
for required_file in "${GENERIC_PBS}" "${PROFILE_FILE}" "${GENERATOR}"; do
  [[ -f "${required_file}" ]] || {
    echo "Required workflow file not found: ${required_file}" >&2
    exit 2
  }
done

export PROJECT_DIR CLUSTER_USER PYTHON OVERWRITE
export NFRB=120000
export ZSOURCE=1.0
export SEED=42
export NSIDE=4096
export MAX_CATALOG_HALOS=0
export HALO_EXTENSION_R200_MULTIPLIER=3.0
export XGPAINT_PROFILE_MASS_DEFINITION=m200c
export DM_PROFILE=lee2022
export LEE2022_CONCENTRATION_MODE=none
export MASS_WINDOWS="m1e10_to_1e12:1e10:1e12,m1e10_to_1e13:1e10:1e13,m1e10_to_1e14:1e10:1e14,m1e10_to_1e15:1e10:1e15,m1e10_to_1e16:1e10:1e16,m1e11_to_1e14:1e11:1e14,m1e12_to_1e14:1e12:1e14,m1e13_to_1e14:1e13:1e14,m1e12_to_1e16:1e12:1e16,m1e13_to_1e16:1e13:1e16,m1e14_to_1e16:1e14:1e16,m1e15_to_1e16:1e15:1e16"
export HDF5_USE_FILE_LOCKING=FALSE
export RUN_PROFILE_2D_CONSISTENCY_CHECK=true
export PROFILE_CHECK_MASS_MSUN=1.0e14
export PROFILE_CHECK_REDSHIFT=0.5
export PROFILE_CHECK_EXTENT_R200C=3.0
export PROFILE_CHECK_RADIAL_POINTS=400
export PROFILE_CHECK_GRID_POINTS=500

CACHE_SIGNATURE="${DM_CACHE}.profile_signature.txt"
if [[ -f "${DM_CACHE}" && -f "${CACHE_SIGNATURE}" ]]; then
  export DM_CACHE_OVERWRITE=false
elif [[ ! -e "${DM_CACHE}" && ! -e "${CACHE_SIGNATURE}" ]]; then
  export DM_CACHE_OVERWRITE=true
else
  echo "Incomplete Lee2022 cache pair; expected both or neither:" >&2
  echo "  ${DM_CACHE}" >&2
  echo "  ${CACHE_SIGNATURE}" >&2
  exit 2
fi

/bin/bash "${GENERIC_PBS}"

HISTOGRAM_HDF5="${OUTPUT_BASE}/${RUN_TAG}/halfdome_uniform_fixedz_foreground_mass_histograms.h5"
"${PYTHON}" - "${HISTOGRAM_HDF5}" <<'PY'
import sys
from pathlib import Path

import h5py

path = Path(sys.argv[1])


def text(value):
    return value.decode() if isinstance(value, bytes) else str(value)


with h5py.File(path, "r") as handle:
    expected = {
        "provenance_dm_profile": "lee2022",
        "provenance_lee2022_concentration_mode": "none",
        "provenance_dm_model_family": (
            "lee2022_table_a2_no_concentration_m200c_profile_owned_los_v2"
        ),
        "provenance_lee2022_density_table": "Appendix A, Table A2",
        "provenance_halo_mass_definition": "M200c",
        "provenance_halo_radius_definition": "R200c",
        "provenance_halo_reference_density": "critical",
        "provenance_dm_cache_interpolation_scheme": (
            "linear B-spline in log(DM); bounded/no cubic overshoot"
        ),
        "provenance_lee2022_los_integrator": (
            "profile-owned explicit Lee22 GNFW integrand with QuadGK"
        ),
    }
    for key, expected_value in expected.items():
        actual = text(handle.attrs[key])
        assert actual == expected_value, (key, actual, expected_value)

    assert int(handle.attrs["n_rays"]) == 120000
    assert int(handle.attrs["provenance_nside"]) == 4096
    assert float(handle.attrs["provenance_source_redshift"]) == 1.0
    assert float(handle.attrs["provenance_halo_extension_r200_multiplier"]) == 3.0
    assert float(handle.attrs["provenance_dm_value_sanity_max"]) == 1.0e8
    assert float(handle.attrs["provenance_dm_cache_grid_maximum_pc_cm3"]) <= 1.0e8
    direct_value = float(handle.attrs["provenance_dm_cache_spot_direct_value_pc_cm3"])
    cached_value = float(handle.attrs["provenance_dm_cache_spot_value_pc_cm3"])
    cached_to_direct = float(
        handle.attrs["provenance_dm_cache_spot_cached_to_direct_ratio"]
    )
    assert direct_value > 0.0, direct_value
    assert cached_value > 0.0, cached_value
    assert 0.2 <= cached_to_direct <= 5.0, cached_to_direct
    assert float(
        handle.attrs["provenance_lee2022_direct_profile_sanity_max_pc_cm3"]
    ) == 1.0e6
    implementation_sha = text(
        handle.attrs["provenance_dm_profile_implementation_sha256"]
    )
    assert len(implementation_sha) == 64, implementation_sha
    assert text(handle.attrs["provenance_dm_cache_profile_signature"]) == (
        "lee2022_table_a2_no_concentration_v2|M200c|R200c|alpha=1|"
        "gamma=-0.3|XH=0.76|profile_owned_los|observer=1/(1+z)"
    )
    assert not bool(
        handle.attrs["provenance_lee2022_xgpaint_private_los_helper_used"]
    )
    assert int(handle.attrs["provenance_catalog_streamed_halos"]) == int(
        handle.attrs["provenance_catalog_total_halos"]
    )
    assert "dm_pc_cm3" not in handle
    signature_file = Path(text(handle.attrs["provenance_dm_cache_profile_signature_file"]))
    assert signature_file.is_file(), signature_file
    assert text(handle.attrs["provenance_lee2022_radial_extrapolation"])
    assert text(handle.attrs["provenance_lee2022_low_mass_extrapolation"])

print(f"Validated Lee2022 no-concentration M200c/3R200c test: {path}")
print(
    "  cache/direct spot check: "
    f"cached={cached_value:.6g}, direct={direct_value:.6g}, "
    f"ratio={cached_to_direct:.6g}"
)
PY

PROFILE_CHECK_DIR="${OUTPUT_BASE}/${RUN_TAG}/profile_consistency"
for product in \
  "${PROFILE_CHECK_DIR}/battaglia16_vs_lee2022_projected_electron_density_radial.csv" \
  "${PROFILE_CHECK_DIR}/battaglia16_vs_lee2022_projected_electron_density_provenance.txt" \
  "${PROFILE_CHECK_DIR}/battaglia16_vs_lee2022_projected_electron_density_2d.png" \
  "${PROFILE_CHECK_DIR}/battaglia16_vs_lee2022_projected_electron_density_2d.pdf"; do
  if [[ ! -s "${product}" ]]; then
    echo "Missing or empty profile-consistency product: ${product}" >&2
    exit 3
  fi
done

echo "Ready to sync for direct comparison:"
echo "  ${HISTOGRAM_HDF5}"
echo "  ${OUTPUT_BASE}/${RUN_TAG}/halfdome_uniform_fixedz_foreground_mass_histograms_summary.csv"
echo "  ${OUTPUT_BASE}/${RUN_TAG}/halfdome_uniform_fixedz_foreground_mass_histograms_provenance.txt"
