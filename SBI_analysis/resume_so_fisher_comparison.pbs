#!/bin/bash
#PBS -N SO_fisher_finish
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=32gb
#PBS -l walltime=23:59:00
#PBS -o /home/kristero10/logs/SBI_runs/
#PBS -e /home/kristero10/logs/SBI_runs/
#PBS -S /bin/bash

set -euo pipefail

WORK_DIR="${PBS_O_WORKDIR:-$PWD}"
cd "${WORK_DIR}"

: "${PROJECT_ROOT:=${WORK_DIR}}"
: "${PYTHON:=python3}"
: "${PYTHON_ENV_SETUP:=}"
: "${FISHER_ROOT:=/lustre/work/kristero10/adrian_fisher_baseline_deproj0}"
: "${FISHER_ANALYSIS_DIR:=${FISHER_ROOT}/analysis}"
: "${OUTPUT_DIR:=${FISHER_ANALYSIS_DIR}/matched_baseline_deproj0_comparison}"
: "${BATTAGLIA_OBSERVATION:=${FISHER_ROOT}/battaglia12_baseline_deproj0_observation/prepared/battaglia12_masked_baseline_noise_cross_deproj0_binned_dell.npy}"
: "${OBSERVATION_VALIDATION_REPORT:=${FISHER_ROOT}/battaglia12_baseline_deproj0_observation/prepared/battaglia12_baseline_deproj0_validation.json}"
: "${PREPARED_DATASET:=/home/kristero10/HalfDome_kSZ/SBI_analysis/data_for_cluster/adrian_so_sbi_cases_ell80_7979_dataset_row_sobolrow/so_masked_baseline_noise_cross_deproj0_ell80_7979_sbi_run.npz}"
: "${SBI_RUN_ROOT:=/home/kristero10/HalfDome_kSZ/SBI_analysis/outputs/cluster_outputs/SBI_Adrian_SO_dataset_size_ell80_7979_dataset_row_metadata_verified_asinh}"
: "${SBI_CASE:=masked_baseline_noise_cross_deproj0}"
: "${NPE_N_TRAIN:=0}"
: "${SBI_SAMPLES:=10000}"
: "${SAMPLE_BATCH_SIZE:=2000}"
: "${PLOT_SAMPLES:=10000}"
: "${PLOT_MODE:=all}"
: "${DEVICE:=cpu}"
: "${DPI:=300}"
: "${SAMPLING_METHOD:=mcmc}"
: "${MCMC_METHOD:=slice_np_vectorized}"
: "${MCMC_WARMUP_STEPS:=200}"
: "${MCMC_THIN:=2}"
: "${MCMC_NUM_CHAINS:=8}"
: "${MCMC_NUM_WORKERS:=1}"
: "${LEAKAGE_DIAGNOSTIC_SAMPLES:=10000}"
: "${FORCE_RESAMPLE:=0}"
: "${OVERWRITE_PLOTS:=0}"

SCRIPT="${PROJECT_ROOT}/SBI_analysis/resume_so_fisher_comparison.py"

for path in \
  "${SCRIPT}" \
  "${PREPARED_DATASET}" \
  "${BATTAGLIA_OBSERVATION}" \
  "${OBSERVATION_VALIDATION_REPORT}" \
  "${FISHER_ANALYSIS_DIR}/fisher_samples_untruncated.npy" \
  "${FISHER_ANALYSIS_DIR}/fisher_samples_prior_truncated.npy"; do
  if [[ ! -f "${path}" ]]; then
    echo "Required completed output does not exist: ${path}" >&2
    exit 2
  fi
done

if [[ -n "${PYTHON_ENV_SETUP}" ]]; then
  eval "${PYTHON_ENV_SETUP}"
fi

ALLOCATED_CPUS="${PBS_NCPUS:-26}"
export OMP_NUM_THREADS="${ALLOCATED_CPUS}"
export OPENBLAS_NUM_THREADS="${ALLOCATED_CPUS}"
export MKL_NUM_THREADS="${ALLOCATED_CPUS}"
export NUMEXPR_NUM_THREADS="${ALLOCATED_CPUS}"
export TORCH_NUM_THREADS="${ALLOCATED_CPUS}"
export TORCH_NUM_INTEROP_THREADS=1

echo "Started: $(date -Is)"
echo "Reusing Fisher outputs: ${FISHER_ANALYSIS_DIR}"
echo "Validated Battaglia12 observation: ${BATTAGLIA_OBSERVATION}"
echo "New comparison output: ${OUTPUT_DIR}"
echo "SBI samples: ${SBI_SAMPLES}, checkpoint batch: ${SAMPLE_BATCH_SIZE}"
echo "Sampler: ${SAMPLING_METHOD}, MCMC method: ${MCMC_METHOD}"
echo "MCMC chains: ${MCMC_NUM_CHAINS}, warmup: ${MCMC_WARMUP_STEPS}, thin: ${MCMC_THIN}"
echo "Plot samples per chain: ${PLOT_SAMPLES}"
echo "Force resample: ${FORCE_RESAMPLE}; overwrite plots: ${OVERWRITE_PLOTS}"
"${PYTHON}" --version

set --
if [[ "${FORCE_RESAMPLE}" == "1" ]]; then
  set -- "$@" --force-resample
fi
if [[ "${OVERWRITE_PLOTS}" == "1" ]]; then
  set -- "$@" --overwrite-plots
fi

"${PYTHON}" "${SCRIPT}" \
  --prepared-dataset "${PREPARED_DATASET}" \
  --fisher-root "${FISHER_ROOT}" \
  --fisher-analysis-dir "${FISHER_ANALYSIS_DIR}" \
  --output-dir "${OUTPUT_DIR}" \
  --battaglia-observation "${BATTAGLIA_OBSERVATION}" \
  --observation-validation-report "${OBSERVATION_VALIDATION_REPORT}" \
  --sbi-run-root "${SBI_RUN_ROOT}" \
  --case "${SBI_CASE}" \
  --npe-n-train "${NPE_N_TRAIN}" \
  --sbi-samples "${SBI_SAMPLES}" \
  --sample-batch-size "${SAMPLE_BATCH_SIZE}" \
  --plot-samples "${PLOT_SAMPLES}" \
  --plot-mode "${PLOT_MODE}" \
  --sampling-method "${SAMPLING_METHOD}" \
  --mcmc-method "${MCMC_METHOD}" \
  --mcmc-warmup-steps "${MCMC_WARMUP_STEPS}" \
  --mcmc-thin "${MCMC_THIN}" \
  --mcmc-num-chains "${MCMC_NUM_CHAINS}" \
  --mcmc-num-workers "${MCMC_NUM_WORKERS}" \
  --leakage-diagnostic-samples "${LEAKAGE_DIAGNOSTIC_SAMPLES}" \
  --device "${DEVICE}" \
  --dpi "${DPI}" \
  "$@"

echo "Finished: $(date -Is)"
echo "Outputs: ${OUTPUT_DIR}"
