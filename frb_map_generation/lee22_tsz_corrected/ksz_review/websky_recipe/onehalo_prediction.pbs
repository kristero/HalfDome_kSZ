#!/bin/bash
#PBS -N ksz_rev_1h
#PBS -q mini_B
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe
# Review of paint_ksz_websky.jl: one-halo prediction of the b16_websky map (ksz_review/websky_recipe/onehalo_prediction.py), 2026-10-02.
set -euo pipefail
D=/lustre/work/kristero10/frb_data/lee22_ksz_review_20261002/websky_recipe
cd $D
export HDF5_USE_FILE_LOCKING=FALSE OMP_NUM_THREADS=1
/home/anaconda3/bin/python3 onehalo_prediction.py /lustre/work/Globus-lt/halfdome/full_res/halos/lightcone_100.hdf5 $D/stein2020_fig6_vector_halo.csv $D > $D/onehalo_prediction.log 2>&1
