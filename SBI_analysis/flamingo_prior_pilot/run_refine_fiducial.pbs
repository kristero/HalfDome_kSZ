#!/bin/bash
#PBS -N FLAM_fid_refine
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=64gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
: "${PILOT:?Set PILOT}"
: "${CAMPAIGN:?Set CAMPAIGN}"
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=26
export PYTHONUNBUFFERED=1 HDF5_USE_FILE_LOCKING=FALSE
exec > "${PILOT}/logs/refine_fiducial.log" 2>&1
trap 'status=$?; printf "%s\n" "$status" > "${PILOT}/logs/refine_fiducial.exit_code"' EXIT
/home/anaconda3/bin/python3 "${PILOT}/code/refine_fiducial.py" \
  --root "$PILOT" --campaign "$CAMPAIGN"
