#!/bin/bash
#PBS -N B12_SO_all
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=128gb
#PBS -l walltime=23:59:00
#PBS -o /home/kristero10/logs/tSZ_two_param/
#PBS -e /home/kristero10/logs/tSZ_two_param/
#PBS -j oe
#PBS -S /bin/bash

set -euo pipefail

WORK_DIR="${PBS_O_WORKDIR:-$PWD}"
cd "${WORK_DIR}"
: "${PROJECT_DIR:=${WORK_DIR}}"
: "${JULIA:=/usr/local/bin/julia}"
: "${PYTHON:=python3}"
: "${LIGHTCONE_ID:=100}"
: "${HALFDOME_PATH:=/lustre/work/Globus-lt/halfdome/full_res/halos/lightcone_${LIGHTCONE_ID}.hdf5}"
: "${BASELINE_NOISE_PATH:=/home/kristero10/tSZ_data/SO_noise/SO_LAT_Nell_T_atmv1_baseline_fsky0p4_ILC_tSZ.txt}"
: "${GOAL_NOISE_PATH:=/home/kristero10/tSZ_data/SO_noise/SO_LAT_Nell_T_atmv1_goal_fsky0p4_ILC_tSZ.txt}"
: "${FINAL_ROOT:=/home/kristero10/final_products/tSZ/battaglia12/masked_so_baseline_goal}"
: "${CACHE_DIR:=/lustre/work/kristero10/tSZ_data/cache}"
: "${MASK_SEED:=12345}"
: "${NOISE_SEED:=2000001}"
: "${THREADS_PER_TASK:=${PBS_NCPUS:-26}}"
: "${FORCE_PACKAGE:=0}"

SIMULATOR="${PROJECT_DIR}/tSZ_visuals/run_halfdome_fullsky_so_noise.jl"
PACKAGER="${PROJECT_DIR}/SBI_analysis/prepare_battaglia12_all_so_final_product.py"
DEPROJ0_DIR="${FINAL_ROOT}/raw/deproj0"
DEPROJ2_DIR="${FINAL_ROOT}/raw/deproj2"
PREPARED_DIR="${FINAL_ROOT}/prepared"

for path in "${SIMULATOR}" "${PACKAGER}" "${HALFDOME_PATH}" \
            "${BASELINE_NOISE_PATH}" "${GOAL_NOISE_PATH}"; do
  [[ -e "${path}" ]] || { echo "Required input does not exist: ${path}" >&2; exit 2; }
done
mkdir -p "${DEPROJ0_DIR}" "${DEPROJ2_DIR}" "${PREPARED_DIR}" "${CACHE_DIR}"

export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

common_args=(
  catalog_source=halfdome
  simulation_name="halfdome_lightcone_${LIGHTCONE_ID}"
  batching_mode=full
  halfdome_path="${HALFDOME_PATH}"
  cache_dir="${CACHE_DIR}"
  baseline_noise_path="${BASELINE_NOISE_PATH}"
  goal_noise_path="${GOAL_NOISE_PATH}"
  nside=4096
  cl_lmax=7979
  so_noise_lmax=7979
  cl_niter=0
  so_noise_is_dl=false
  apply_gaussian_beam=true
  gaussian_beam_fwhm_arcmin=2.0
  mask_fsky=0.4
  mask_apodization_arcmin=60.0
  seed="${MASK_SEED}"
  mask_seed="${MASK_SEED}"
  noise_seed="${NOISE_SEED}"
  model_exists=false
  reuse_existing_cache=true
  cache_wait_seconds=0
  cache_poll_seconds=30
  interpolator_pad=256
  interpolator_logM_max=15.7
  save_healpix_map=false
  save_bin_maps=false
  save_mass_map=false
  save_cl=true
  save_unmasked_no_noise_cl=false
  save_baseline_noise_cross_cl=true
  save_goal_noise_cross_cl=true
  save_noise_maps=false
  save_signal_map=false
  skip_existing_outputs=false
  skip_existing_any_run_instance=false
  enforce_battaglia_guardrails=true
  skip_invalid_battaglia_rows=false
  run_instance_tag=
  print_runtime_environment=false
  battaglia_P0_amp=18.1
  battaglia_x_c_amp=0.497
  battaglia_beta_amp=4.35
  battaglia_P0_alpha_m=0.154
  battaglia_x_c_alpha_m=-0.00865
  battaglia_beta_alpha_m=0.0393
  battaglia_P0_alpha_z=-0.758
  battaglia_x_c_alpha_z=0.731
  battaglia_beta_alpha_z=0.415
  battaglia_alpha_amp=1.0
  battaglia_alpha_alpha_m=0.0
  battaglia_alpha_alpha_z=0.0
  battaglia_gamma_amp=-0.3
  battaglia_gamma_alpha_m=0.0
  battaglia_gamma_alpha_z=0.0
)

echo "Started Battaglia12 all-SO validation product: $(date -Is)"
echo "Deprojection 0: spectra plus masked clean/mask/noisy-split FITS maps"
JULIA_NUM_THREADS="${THREADS_PER_TASK}" \
"${JULIA}" --threads="${THREADS_PER_TASK}" "${SIMULATOR}" \
  "${common_args[@]}" \
  output_dir="${DEPROJ0_DIR}" \
  so_noise_deprojections=0 \
  save_no_noise_cl=true \
  save_mask_map=true \
  save_masked_signal_map=true \
  save_noisy_maps=true

echo "Deprojection 2: spectra only"
JULIA_NUM_THREADS="${THREADS_PER_TASK}" \
"${JULIA}" --threads="${THREADS_PER_TASK}" "${SIMULATOR}" \
  "${common_args[@]}" \
  output_dir="${DEPROJ2_DIR}" \
  so_noise_deprojections=2 \
  save_no_noise_cl=false \
  save_mask_map=false \
  save_masked_signal_map=false \
  save_noisy_maps=false

package_args=()
if [[ "${FORCE_PACKAGE}" == "1" ]]; then
  package_args+=(--force)
fi
"${PYTHON}" "${PACKAGER}" \
  --deproj0-dir "${DEPROJ0_DIR}" \
  --deproj2-dir "${DEPROJ2_DIR}" \
  --output-dir "${PREPARED_DIR}" \
  --mask-seed "${MASK_SEED}" \
  --noise-seed "${NOISE_SEED}" \
  "${package_args[@]}"

echo "Finished: $(date -Is)"
echo "Reusable product: ${PREPARED_DIR}/battaglia12_masked_so_all_noise_ell80_7979.npz"
