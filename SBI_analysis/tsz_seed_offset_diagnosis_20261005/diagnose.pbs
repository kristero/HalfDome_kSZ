#!/bin/bash
#PBS -N seed_bias
#PBS -q mini2
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=48gb
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
ROOT=/lustre/work/kristero10/tsz_seed_offset_diagnosis_20261005
cd "$ROOT"
exec > "logs/diagnose_${PBS_JOBID%%.*}.log" 2>&1
export OMP_NUM_THREADS=26 OPENBLAS_NUM_THREADS=26 MKL_NUM_THREADS=26
export MERLIN_PARAM_SPACE=linear MPLBACKEND=Agg
echo "host=$(hostname) start=$(date -Is)"
/usr/bin/time -v -o "logs/resources_${PBS_JOBID%%.*}.txt" \
 /home/kristero10/envs/sbi27/bin/python diagnose.py --root "$ROOT" --threads 26 --samples 9000
echo "finished=$(date -Is)"
