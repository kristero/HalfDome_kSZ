# EDIT these paths and resource settings on the collaborator's cluster.
: "${HALFDOME_PATH:=/EDIT/halfdome/lightcone_100.hdf5}"
: "${OUTPUT_ROOT:=/EDIT/scratch/so_32k_independent_noise}"
: "${JULIA:=julia}"
: "${PYTHON:=python3}"
: "${QUEUE:=mini}"
: "${CPUS:=26}"
: "${MEMORY:=128gb}"
: "${WALLTIME:=23:59:00}"
: "${N_WORKERS:=20}"
: "${MAX_ACTIVE_JOBS:=5}"
# Stop before PBS kills the process, leaving time to save a completed row.
: "${WORK_SECONDS:=81000}"
: "${ROW_TIMEOUT_SECONDS:=2400}"
export HALFDOME_PATH OUTPUT_ROOT JULIA PYTHON CPUS WORK_SECONDS ROW_TIMEOUT_SECONDS
