#!/bin/bash
#PBS -N fb_mtrain
#PBS -j oe
# Merlin (asinh inputs, early stop 30 / lr patience 10, 61,440-row pool, seeds 1-3) on the inputs of
# merlin_w420_prepare.py, then its evaluation (3,000 test rows, B12 posterior samples). SPACE=logit: bounded, in
# results_merlin_unbinned_beam_w420_asinh_p30; SPACE=linear: unbounded, in ..._lin (features linked in).
#   qsub -q mini_B -l select=1:ncpus=16:mem=32gb -l walltime=06:00:00 -v SPACE=logit|linear merlin_train.pbs
set -uo pipefail
R=$HOME/tsz64k_fisher_b12_20261002
L=$HOME/sbi_reruns_20261001/SBI_analysis/tsz64k_sbi_local; cd $L
SPACE=${SPACE:-logit}
exec > $R/logs/merlin_train_${SPACE}_${PBS_JOBID%%.*}.log 2>&1
PY=/home/kristero10/envs/sbi27/bin/python; C=${NCPUS:-16}
TAG=_beam_w420_asinh_p30; S=results_merlin_unbinned$TAG
[ -s $S/features_merlin.npz ] || { echo "no $S/features_merlin.npz"; exit 1; }
if [ $SPACE = linear ]; then
  O=${S}_lin; mkdir -p $O
  for f in features_merlin.npz features_moped.npz prepare.json; do [ -e $S/$f ] && ln -sfn ../$S/$f $O/$f; done
  TAG=${TAG}_lin
fi
export MERLIN_TAG=$TAG MERLIN_PARAM_SPACE=$SPACE MERLIN_PATIENCE=30 MERLIN_LR_PATIENCE=10 MPLBACKEND=Agg PYTHONUNBUFFERED=1
echo "host=$(hostname) ncpus=$C tag=$TAG space=$SPACE start=$(date -Is)"
OMP_NUM_THREADS=4 $PY merlin_compression.py train --variants merlin --seeds 1 2 3 --workers 3 --threads 4 && \
OMP_NUM_THREADS=$C $PY merlin_compression.py evaluate --variants merlin --threads $C
code=$?; echo "finished=$(date -Is) code=$code"; exit $code
