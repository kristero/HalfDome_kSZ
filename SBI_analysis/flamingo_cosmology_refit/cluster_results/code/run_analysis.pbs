#!/bin/bash
#PBS -N flamingo_cosmo
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=64gb
#PBS -l walltime=23:59:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
: "${RUN_ROOT:?Set RUN_ROOT}"
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=26
export HDF5_USE_FILE_LOCKING=FALSE PYTHONUNBUFFERED=1 MPLBACKEND=Agg
export PYTHONPATH="${RUN_ROOT}/runtime:${RUN_ROOT}/code"
if [[ "${TASK:-}" == "background" ]]; then
    /home/anaconda3/bin/python3 "${RUN_ROOT}/code/background.py" --root "${RUN_ROOT}"
    exec /home/anaconda3/bin/python3 "${RUN_ROOT}/code/check_response.py" --root "${RUN_ROOT}"
else
    : "${VARIANT:?Set VARIANT}"
    exec /home/anaconda3/bin/python3 "${RUN_ROOT}/code/refit.py" --root "${RUN_ROOT}" --variant "${VARIANT}"
fi
