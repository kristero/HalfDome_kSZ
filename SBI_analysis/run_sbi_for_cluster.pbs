#PBS -N sbi_for_cluster
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=128gb
#PBS -l walltime=04:00:00
#PBS -o /home/kristero10/logs/SBI_runs/
#PBS -e /home/kristero10/logs/SBI_runs/
#PBS -S /bin/bash

set -euo pipefail

WORK_DIR=${PBS_O_WORKDIR:-$PWD}
cd "$WORK_DIR"

: ${PYTHON:=python3}
: ${PYTHON_ENV_SETUP:=}
: ${LOG_DIR:=/home/kristero10/logs/SBI_runs}

ALLOCATED_CPUS=${PBS_NCPUS:-${NCPUS:-}}
if [ -z "$ALLOCATED_CPUS" ] && [ -n "${PBS_NODEFILE:-}" ] && [ -f "$PBS_NODEFILE" ]; then
  ALLOCATED_CPUS=$(wc -l < "$PBS_NODEFILE")
fi
if [ -z "$ALLOCATED_CPUS" ]; then
  ALLOCATED_CPUS=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
fi

: ${SBI_NUM_THREADS:=$ALLOCATED_CPUS}
: ${OMP_NUM_THREADS:=$SBI_NUM_THREADS}
: ${OPENBLAS_NUM_THREADS:=$SBI_NUM_THREADS}
: ${MKL_NUM_THREADS:=$SBI_NUM_THREADS}
: ${NUMEXPR_NUM_THREADS:=$SBI_NUM_THREADS}
: ${TORCH_NUM_THREADS:=$SBI_NUM_THREADS}
: ${TORCH_NUM_INTEROP_THREADS:=1}
: ${SBI_DEVICE:=cpu}
: ${SBI_SEED:=42}
: ${SBI_GAUSSIAN_BEAM_FWHM_ARCMIN:=0.0}
: ${SBI_GAUSSIAN_BEAM_MODE:=off}
: ${SBI_DENSITY_ESTIMATOR:=maf}
: ${SBI_STOP_AFTER_EPOCHS:=60}
: ${SBI_NUM_POSTERIOR_SAMPLES:=100000}
: ${SBI_DATASET_SIZE_GROUP_1:=100e3}
: ${SBI_DATASET_SIZE_GROUP_2:=85e3,4096}
: ${SBI_DATASET_SIZE_GROUP_3:=70e3,16384,2048,1024}
: ${SBI_DATASET_SIZE_GROUP_4:=50e3,32768,8192}
: ${SBI_GROUP_ID:=}
: ${SBI_DATASET_ORDER:=shuffle}
: ${PREPARED_DATASET_PATH:=}
: ${PREPARED_THETA_PATH:=}
: ${PREPARED_X_PATH:=}
: ${PREPARED_OBS_PATH:=}
: ${PREPARED_PRIOR_PATH:=}

DEFAULT_PREPARED_DATASET_CANDIDATE=$WORK_DIR/SBI_analysis/data_for_cluster/emulated_so_binned_beam2arcmin_sbi_run.npz
DEFAULT_PREPARED_DATASET_CANDIDATE_ALT=$WORK_DIR/data_for_cluster/emulated_so_binned_beam2arcmin_sbi_run.npz
PREPARED_CLUSTER_DATASET_CANDIDATE=$WORK_DIR/SBI_analysis/data_for_cluster/prepared_cluster_sbi_run.npz
PREPARED_CLUSTER_DATASET_CANDIDATE_ALT=$WORK_DIR/data_for_cluster/prepared_cluster_sbi_run.npz
PLANCK_PREPARED_DATASET_CANDIDATE=$WORK_DIR/SBI_analysis/data_for_cluster/planck_binned16_no_noise_sbi_run.npz
PLANCK_PREPARED_DATASET_CANDIDATE_ALT=$WORK_DIR/data_for_cluster/planck_binned16_no_noise_sbi_run.npz
PREPARE_SBI_DATASET_CANDIDATE=/lustre/work/kristero10/tSZ_data/sbi_battaglia9_full_ell/sbi_prepared_dataset.npz
PREPARE_SBI_OBS_CANDIDATE=/lustre/work/kristero10/tSZ_data/sbi_battaglia9_full_ell/observed_log10_dl.npy
LEGACY_PREPARED_DATASET_CANDIDATE=$WORK_DIR/SBI_analysis/data_for_cluster/_sbi_run.npz
LEGACY_PREPARED_DATASET_CANDIDATE_ALT=$WORK_DIR/data_for_cluster/_sbi_run.npz
if [ -z "$PREPARED_DATASET_PATH" ] && [ -f "$DEFAULT_PREPARED_DATASET_CANDIDATE" ]; then
  PREPARED_DATASET_PATH=$DEFAULT_PREPARED_DATASET_CANDIDATE
elif [ -z "$PREPARED_DATASET_PATH" ] && [ -f "$DEFAULT_PREPARED_DATASET_CANDIDATE_ALT" ]; then
  PREPARED_DATASET_PATH=$DEFAULT_PREPARED_DATASET_CANDIDATE_ALT
elif [ -z "$PREPARED_DATASET_PATH" ] && [ -f "$PREPARED_CLUSTER_DATASET_CANDIDATE" ]; then
  PREPARED_DATASET_PATH=$PREPARED_CLUSTER_DATASET_CANDIDATE
elif [ -z "$PREPARED_DATASET_PATH" ] && [ -f "$PREPARED_CLUSTER_DATASET_CANDIDATE_ALT" ]; then
  PREPARED_DATASET_PATH=$PREPARED_CLUSTER_DATASET_CANDIDATE_ALT
elif [ -z "$PREPARED_DATASET_PATH" ] && [ -f "$PLANCK_PREPARED_DATASET_CANDIDATE" ]; then
  PREPARED_DATASET_PATH=$PLANCK_PREPARED_DATASET_CANDIDATE
elif [ -z "$PREPARED_DATASET_PATH" ] && [ -f "$PLANCK_PREPARED_DATASET_CANDIDATE_ALT" ]; then
  PREPARED_DATASET_PATH=$PLANCK_PREPARED_DATASET_CANDIDATE_ALT
elif [ -z "$PREPARED_DATASET_PATH" ] && [ -f "$PREPARE_SBI_DATASET_CANDIDATE" ]; then
  PREPARED_DATASET_PATH=$PREPARE_SBI_DATASET_CANDIDATE
elif [ -z "$PREPARED_DATASET_PATH" ] && [ -f "$LEGACY_PREPARED_DATASET_CANDIDATE" ]; then
  PREPARED_DATASET_PATH=$LEGACY_PREPARED_DATASET_CANDIDATE
elif [ -z "$PREPARED_DATASET_PATH" ] && [ -f "$LEGACY_PREPARED_DATASET_CANDIDATE_ALT" ]; then
  PREPARED_DATASET_PATH=$LEGACY_PREPARED_DATASET_CANDIDATE_ALT
fi
if [ -z "$PREPARED_OBS_PATH" ] && [ "$PREPARED_DATASET_PATH" = "$PREPARE_SBI_DATASET_CANDIDATE" ] && [ -f "$PREPARE_SBI_OBS_CANDIDATE" ]; then
  PREPARED_OBS_PATH=$PREPARE_SBI_OBS_CANDIDATE
fi

if [ -f "$WORK_DIR/sbi_for_cluster.py" ]; then
  SCRIPT=$WORK_DIR/sbi_for_cluster.py
elif [ -f "$WORK_DIR/SBI_analysis/sbi_for_cluster.py" ]; then
  SCRIPT=$WORK_DIR/SBI_analysis/sbi_for_cluster.py
elif [ -f "$WORK_DIR/../SBI_analysis/sbi_for_cluster.py" ]; then
  SCRIPT=$WORK_DIR/../SBI_analysis/sbi_for_cluster.py
else
  echo Could not locate sbi_for_cluster.py from WORK_DIR=$WORK_DIR >&2
  exit 1
fi

SCRIPT_DIR=$(cd "$(dirname "$SCRIPT")" && pwd)
JOB_ID=${PBS_JOBID:-manual}
GROUP_ID=${SBI_GROUP_ID:-${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-1}}}
case "$GROUP_ID" in
  1)
    SBI_DATASET_SIZES=$SBI_DATASET_SIZE_GROUP_1
    ;;
  2)
    SBI_DATASET_SIZES=$SBI_DATASET_SIZE_GROUP_2
    ;;
  3)
    SBI_DATASET_SIZES=$SBI_DATASET_SIZE_GROUP_3
    ;;
  4)
    SBI_DATASET_SIZES=$SBI_DATASET_SIZE_GROUP_4
    ;;
  *)
    echo "Unsupported SBI_GROUP_ID/PBS array task id: $GROUP_ID. Expected 1, 2, 3, or 4." >&2
    exit 2
    ;;
esac
JOB_ROOT=$(printf '%s' "$JOB_ID" | sed 's/\[[^]]*\]//g')
LOG_JOB_TAG=$(printf '%s' "$JOB_ID" | tr '[]' '__')
OUTPUT_ROOT=$SCRIPT_DIR/outputs/sbi_for_cluster/$JOB_ROOT
OUTPUT_BASE=$OUTPUT_ROOT/group${GROUP_ID}
: ${SBI_OUTPUT_DIR:=$OUTPUT_BASE}
: ${POSTERIOR_SAVE_PATH:=$OUTPUT_BASE/posterior_samples.npy}

mkdir -p "$LOG_DIR" "$SBI_OUTPUT_DIR"

if [ -n "$PYTHON_ENV_SETUP" ]; then
  eval "$PYTHON_ENV_SETUP"
fi

export OMP_NUM_THREADS OPENBLAS_NUM_THREADS MKL_NUM_THREADS NUMEXPR_NUM_THREADS
export TORCH_NUM_THREADS TORCH_NUM_INTEROP_THREADS
export SBI_DEVICE SBI_SEED SBI_GAUSSIAN_BEAM_FWHM_ARCMIN SBI_GAUSSIAN_BEAM_MODE SBI_DENSITY_ESTIMATOR
export SBI_STOP_AFTER_EPOCHS SBI_NUM_POSTERIOR_SAMPLES
export SBI_DATASET_SIZES SBI_DATASET_ORDER SBI_OUTPUT_DIR
export PREPARED_DATASET_PATH PREPARED_THETA_PATH PREPARED_X_PATH
export PREPARED_OBS_PATH PREPARED_PRIOR_PATH
export POSTERIOR_SAVE_PATH

if [ -z "$PREPARED_DATASET_PATH" ]; then
  if [ -z "$PREPARED_THETA_PATH" ] || [ -z "$PREPARED_X_PATH" ] || [ -z "$PREPARED_OBS_PATH" ] || [ -z "$PREPARED_PRIOR_PATH" ]; then
    echo Set PREPARED_DATASET_PATH or PREPARED_THETA_PATH, PREPARED_X_PATH, PREPARED_OBS_PATH, and PREPARED_PRIOR_PATH >&2
    echo No default prepared dataset was found at: $DEFAULT_PREPARED_DATASET_CANDIDATE >&2
    echo Alternate default checked: $DEFAULT_PREPARED_DATASET_CANDIDATE_ALT >&2
    echo Cluster prepared defaults checked: $PREPARED_CLUSTER_DATASET_CANDIDATE and $PREPARED_CLUSTER_DATASET_CANDIDATE_ALT >&2
    echo Planck defaults checked: $PLANCK_PREPARED_DATASET_CANDIDATE and $PLANCK_PREPARED_DATASET_CANDIDATE_ALT >&2
    echo prepare_sbi_dataset.py default checked: $PREPARE_SBI_DATASET_CANDIDATE >&2
    echo Legacy defaults checked: $LEGACY_PREPARED_DATASET_CANDIDATE and $LEGACY_PREPARED_DATASET_CANDIDATE_ALT >&2
    echo Example: qsub -v PREPARED_DATASET_PATH=/path/to/prepared_sbi_dataset.npz run_sbi_for_cluster.pbs >&2
    exit 2
  fi
fi

for required_path in "$PREPARED_DATASET_PATH" "$PREPARED_THETA_PATH" "$PREPARED_X_PATH" "$PREPARED_OBS_PATH" "$PREPARED_PRIOR_PATH"; do
  if [ -n "$required_path" ] && [ ! -f "$required_path" ]; then
    echo Input path does not exist: $required_path >&2
    exit 2
  fi
done

echo PBS job id: $JOB_ID
echo Working directory: $WORK_DIR
echo Host: $(hostname)
echo Date: $(date -Is)
echo Python script: $SCRIPT
echo Python executable: $PYTHON
$PYTHON --version
echo Prepared dataset: ${PREPARED_DATASET_PATH:-not_set}
echo SBI group id: $GROUP_ID
echo SBI output root: $OUTPUT_ROOT
echo SBI output directory: $SBI_OUTPUT_DIR
echo Dataset sizes: $SBI_DATASET_SIZES
echo Dataset size groups:
echo "  group1: $SBI_DATASET_SIZE_GROUP_1"
echo "  group2: $SBI_DATASET_SIZE_GROUP_2"
echo "  group3: $SBI_DATASET_SIZE_GROUP_3"
echo "  group4: $SBI_DATASET_SIZE_GROUP_4"
echo Dataset order: $SBI_DATASET_ORDER
echo Gaussian beam FWHM arcmin: $SBI_GAUSSIAN_BEAM_FWHM_ARCMIN
echo Gaussian beam mode: $SBI_GAUSSIAN_BEAM_MODE
echo Posterior output: $POSTERIOR_SAVE_PATH
echo Validation losses output: $SBI_OUTPUT_DIR/validation_losses.json
echo Training summary output: $SBI_OUTPUT_DIR/training_summary_stdout.txt
echo Allocated CPUs: $ALLOCATED_CPUS
echo SBI_NUM_THREADS: $SBI_NUM_THREADS
echo OMP_NUM_THREADS: $OMP_NUM_THREADS
echo OPENBLAS_NUM_THREADS: $OPENBLAS_NUM_THREADS
echo MKL_NUM_THREADS: $MKL_NUM_THREADS
echo TORCH_NUM_THREADS: $TORCH_NUM_THREADS
echo TORCH_NUM_INTEROP_THREADS: $TORCH_NUM_INTEROP_THREADS

$PYTHON - <<'PY'
import sys

try:
    import numpy
    import torch
    try:
        from sbi.inference import NPE
    except ImportError:
        from sbi.inference import SNPE
except Exception as exc:
    print("Python/SBI environment import check failed:", repr(exc), file=sys.stderr)
    print("If this mentions backports.tarfile, fix the mixed conda/user-site environment.", file=sys.stderr)
    print("Try: python -m pip install --user backports.tarfile", file=sys.stderr)
    print("If that does not work, try: python -m pip install --user 'setuptools<70'", file=sys.stderr)
    raise SystemExit(1)
PY

RUN_LOG_BASE=sbi_for_cluster_${LOG_JOB_TAG}_group${GROUP_ID}
$PYTHON "$SCRIPT" > "$LOG_DIR/${RUN_LOG_BASE}.out" 2> "$LOG_DIR/${RUN_LOG_BASE}.err"

echo Job finished.
