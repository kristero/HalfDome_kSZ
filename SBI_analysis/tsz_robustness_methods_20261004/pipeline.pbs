#!/bin/bash
#PBS -N robust_sbi
#PBS -q mini
#PBS -l select=1:ncpus=26:mpiprocs=1:mem=48gb
#PBS -l walltime=23:59:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
: "${RUN_ROOT:?}"
cd "$RUN_ROOT"
exec > "logs/pipeline_${PBS_JOBID%%.*}.log" 2>&1
export PYTHONUNBUFFERED=1 MPLBACKEND=Agg
export OMP_NUM_THREADS=26 OPENBLAS_NUM_THREADS=26 MKL_NUM_THREADS=26
echo "host=$(hostname) start=$(date -Is)"
/usr/bin/time -v -o "logs/resources_pipeline_${PBS_JOBID%%.*}.txt" \
 /home/kristero10/envs/sbi27/bin/python code/pipeline.py --root "$RUN_ROOT" --threads=26
echo "finished=$(date -Is)"
