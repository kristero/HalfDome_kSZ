#!/bin/bash
#PBS -N SO2vs9plots
#PBS -q mini
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -S /bin/bash
set -euo pipefail
: "${ROOT:=/lustre/work/kristero10/two_param_compression_convergence_32k_v1}"
: "${NINE_ROOT:=/lustre/work/kristero10/adrian_9param_compression_baseline_deproj0_bestval_20260909}"
: "${NINE_CSV:=/home/kristero10/HalfDome_kSZ/SBI_analysis/outputs/cluster_outputs/SBI_Adrian_SO_dataset_size_ell80_7979_dataset_row_metadata_verified_asinh/diagnostics_last100/last100_param_metrics.csv}"
: "${CODE_DIR:=${ROOT}/comparison_code_20260913}"
: "${OUTPUT:=${ROOT}/comparison_with_nine_20260913}"
: "${PYTHON:=/home/anaconda3/bin/python3}"
mkdir -p "${ROOT}/logs"
exec > >(tee -a "${ROOT}/logs/comparison_two_vs_nine_${PBS_JOBID:-manual}.log") 2>&1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 MPLBACKEND=Agg PYTHONUNBUFFERED=1
echo "Started $(date -Is) on $(hostname)"
"${PYTHON}" "${CODE_DIR}/compare_so_fixed_two_vs_nine.py" \
    --two-root "${ROOT}" --nine-root "${NINE_ROOT}" \
    --nine-convergence-csv "${NINE_CSV}" --allow-preliminary-nine --output-dir "${OUTPUT}"
echo "Finished $(date -Is)"
